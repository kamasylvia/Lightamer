# Tuist conventions: Project.swift is the source of truth — never commit generated projects.
*.xcodeproj
*.xcworkspace
DerivedData/
Derived/
.tuist/
Tuist/Dependencies/
Tuist/Cache/
.DS_Store

# Local build products (xcodebuild incremental) — never commit.
build/

# input/ is regenerable sample material, EXCEPT the golden-reference
# infrastructure (Plan 03-01): regenerate.sh + the fixture generator +
# the pinned XMP cases + the manifest are committed; the fixtures
# themselves, golden outputs, and the transient .conf dir regenerate via
# `bash input/golden/regenerate.sh`.
input/*
!input/golden/
input/golden/*
!input/golden/regenerate.sh
!input/golden/manifest.md
!input/golden/fixtures/
input/golden/fixtures/*
!input/golden/fixtures/gen_fixtures.py
!input/golden/fixtures/gen_noise_profiles.py
!input/golden/fixtures/lensfun/
input/golden/fixtures/lensfun/*
!input/golden/fixtures/lensfun/*.xml
# Plan 08-2: the CoreText SELF-BASELINE watermark goldens are the frozen
# reference (regenerate = LA_REGEN_YIYIN_GOLDEN=1 + re-freeze discipline,
# D-08-CONTEXT-8 — system font dependency).
!input/golden/yiyin-watermark/
!input/golden/fixtures/lensfun/README.md
!input/golden/cases/
# Plan 12-5 T1: the synthetic dirty .cube fixtures are the parser's
# committed dirty-sample evidence (the network sweep failed per plan
# protocol; synthetic replacement, 12-5-DECISIONS D5).
!input/cube/

# 9-3 D10 抽检再生成物：复跑必 dirty，留工作区不入库（9-3 验收注记①，2026-09-26 兑现）
.work/gui-acceptance/09-3-tiers-raf-A-vs-B.jpg

# reasonix CLI session artifacts
/.reasonix/

# Plan M2-10-01 (E1): bundled AI model assets live at the repo-root
# Resources/AIModels folder reference — model BYTES never enter git
# (volume red line). The directory itself is tracked via .keep; the
# conversion scripts + digest lock in Scripts/ai-models are the
# reproducible source of everything in here.
Resources/AIModels/**
!Resources/AIModels/.keep

