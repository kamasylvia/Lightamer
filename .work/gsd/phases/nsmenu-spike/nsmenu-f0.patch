+        func bare(_ title: String, key: String? = nil,
+                  mask: NSEvent.ModifierFlags = [],
+                  _ action: @escaping () -> Void) {
+            let it = item(m, title: title, key: key, mask: mask, action: action)
+            register(enabled: { [weak self] in
