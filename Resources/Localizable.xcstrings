    },
    "hdr_merge_dialog_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merges the selected bracket into a new 32-bit float HDR document in the session root. The sources stay untouched. Note: with only 3 frames the ghost detection is statistically weak."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选括号合并为会话根目录下的新 32-bit float HDR 文档，源文件不受影响。注意：仅 3 帧时鬼影检测的统计能力较弱。"
          }
        }
      }
    },
    "hdr_merge_dialog_deghost": {
