    "ai_download_accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "ai_download_decline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不"
          }
        }
      }
    },
    "ai_download_failed_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tap-to-segment model could not be downloaded. Retry, or keep using offline subject masking."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击选取模型下载失败。可重试，或继续使用离线主体蒙版。"
          }
        }
      }
    },
    "ai_download_failed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Download Failed"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "模型下载失败"
          }
        }
      }
    },
    "ai_download_not_ready_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download call returned without an error, but the system still reports the model assets as not ready. On this macOS beta this happens when asset provisioning is unavailable to the current build context (test-entitlement or development-signed runs). The assets are machine-level: once any properly provisioned app (or a Developer ID build) completes the download, this entry turns ready. You can retry now."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下载调用未报错，但系统仍报告模型资产未就绪。在此 macOS beta 上，资产供给对当前构建上下文（测试 entitlement 或开发签名运行）不可用时会这样。该资产为机器级：任一可正常供给的应用（或 Developer ID 构建）完成下载后，此入口即转为就绪。你可以现在重试。"
          }
        }
      }
    },
    "ai_download_progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading AI model…"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载 AI 模型…"
          }
        }
      }
    },
    "ai_download_prompt_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interactive tap-to-segment model (about a few MB) downloads once, then works fully offline. Subject masking without it stays available."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "交互式点击选取模型（数 MB）只需下载一次，之后完全离线可用。不下载也不影响一键主体蒙版。"
          }
        }
      }
    },
    "ai_download_prompt_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
