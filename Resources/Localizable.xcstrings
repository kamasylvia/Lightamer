    "toast_drift_detected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidecar was edited outside Lightamer — keeping the in-session state (the file will be rewritten on your next edit)"
