    "settings_mcp_placeholders_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placeholders: {{LIGHTAMER_MCP}} = endpoint discovery file path; {{PROMPT}} = task prompt (inlined single-quote escaped). The template runs via /bin/zsh -c as YOUR OWN command — the app never calls a model."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "占位符：{{LIGHTAMER_MCP}} = 端点发现文件路径；{{PROMPT}} = 任务提示词（单引号转义后内联）。模板经 /bin/zsh -c 执行，命令作者是你自己——app 不含任何模型调用。"
          }
        }
      }
    },
