    "panel_lens_embedded_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The decoded image already includes the lens correction embedded by the camera/RAW decoder for supported lenses. Manual correction below defaults to OFF — enable only for uncorrected lenses to avoid double correction."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "解码后的图像已包含相机/RAW 解码器对支持镜头的内嵌校正。下方手动校正默认关闭——仅对未校正镜头启用，避免双重校正。"
          }
        }
      }
    },
