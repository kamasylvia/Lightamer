      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All metadata is re-projected from the sessions; the categories and collections organization data in the catalog will be discarded (back up the .lcat file first if you need it)."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将把全部元数据从会话重新投影；目录库中的分类与集合组织数据将被丢弃（如需保留请先备份 .lcat 文件）。"
          }
        }
      }
    },
