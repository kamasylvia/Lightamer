{
  "sourceLanguage": "en",
  "strings": {
    "a11y_empty_state_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty state: no session loaded. Press the button to select a folder, or drag a RAW file here."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "空状态：未加载会话。点按按钮选择文件夹，或将 RAW 文件拖放到此处。"
          }
        }
      }
    },
    "a11y_inspector_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image metadata and adjustment modules"
