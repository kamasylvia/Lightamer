    "empty_state_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightamer organizes your photos as sessions. Choose a folder to get started, or drag a RAW file here to open it directly."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightamer 以会话方式组织照片。选择一个文件夹即可开始，或将 RAW 文件拖放到此处直接打开。"
          }
        }
      }
