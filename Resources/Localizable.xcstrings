    "mcp_tool_desc_get_schema": {
      "localizations": {
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每个可编辑字段：其在 apply_params params 对象中的路径、类型、界面范围与含义，编辑前必读。每个 op 给出 opName、显示名、v50 iopOrder、VERSION（变化时请刷新缓存）、适用域与每个参数字段的路径、类型、范围、含义及规范默认值。范围是界面的（面板档位）——越界写入被拒绝而非钳制。本文档缺席的 op 仍可经 apply_params 全 JSON 替换，无字段参考。只读、无状态，除 internalError 外无其他错误。"
          }
        }
      }
    },
