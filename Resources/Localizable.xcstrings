    "focus_stack_dialog_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligns the focus rail (MTB), measures sharpness (SML) and blends a quality-weighted Laplacian pyramid. Sources are never modified."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "对焦轨 MTB 对齐后以 SML 度量清晰度，加权拉普拉斯金字塔融合。源文件不会被修改。"
          }
        }
      }
    },
    "focus_stack_dialog_start": {
      "localizations": {
        "en": {
